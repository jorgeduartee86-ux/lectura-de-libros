# Variables públicas que Vite puede incluir en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_APP_BASE_PATH=/

# Solo para `supabase functions serve` o secretos remotos de Edge Functions.
# Nunca uses el prefijo VITE_ en estas variables privadas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com
ALLOWED_ORIGINS=http://localhost:5173
RELATIONSHIP_EMAIL_ALLOWLIST=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nuestra-historia-media
R2_ENDPOINT=
